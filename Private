local animatedGradients = {}
local function attachAnimatedGradient(target, c1, c2, c3)
    if not target then return nil end
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, c1 or colors.blueHi),
        ColorSequenceKeypoint.new(0.5, c2 or colors.blue),
        ColorSequenceKeypoint.new(1, c3 or colors.blueHi),
    })
    grad.Parent = target
    table.insert(animatedGradients, grad)
    return grad
end

