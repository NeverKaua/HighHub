-- ===== LOOP: Ping =====
task.spawn(function()
    local function getPingValue()
        local net = Stats:FindFirstChild("Network")
        if net then
            local p = net:FindFirstChild("Ping")
            if p and typeof(p.Value) == "number" and p.Value > 0 then
                return p.Value
            end
        end
        if Stats.GetNetworkPing then
            local ok, val = pcall(function() return Stats:GetNetworkPing() end)
            if ok and val and val > 0 then return val * 1000 end
        end
        if lp.GetNetworkPing then
            local ok, val = pcall(function() return lp:GetNetworkPing() end)
            if ok and val and val > 0 then return val * 1000 end
        end
        return 0
    end

    while true do
        task.wait(1)
        local pingMs = getPingValue()
        if pingMs > 0 then
            currentPing = pingMs / 1000
        end
    end
end)

-- ===== DRAG (usa headerFrame como handle) =====
local dragging = false
local dragStart
local startPosition

local function updateDrag(input)
    local delta = input.Position - dragStart
    panel.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )
end

headerFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = panel.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)

-- ===== RESPONSIVO =====
local function adaptToScreen()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    if viewport.X < 700 then
        if not minimized then
            panel.Size = UDim2.new(0, math.min(BASE_W, viewport.X - 28), 0, BASE_H)
        end
        panel.Position = UDim2.new(0, 14, 0.5, 0)
    end
end

adaptToScreen()
if workspace.CurrentCamera then
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(adaptToScreen)
end

return gui
