-- ===== STEAL LOGIC =====
local function executeSteal(prompt)
    if resetAnimationPlaying then return end
    if isStealing then return end
    if not prompt or not prompt.Parent then return end

    local hold, trigger = getPromptConnections(prompt)
    if #hold == 0 and #trigger == 0 then
        setStatus("No connections on prompt.", colors.red)
        return
    end

    isStealing = true
    blockTriggered = false
    activeThread = activeThread + 1
    local myThread = activeThread
    setStatus("Stealing...", colors.blue)

    task.spawn(function()
        if blockEnabled then task.spawn(doBlock) end

        for _, f in ipairs(hold) do pcall(f) end

        local startTime = os.clock()
        while true do
            if activeThread ~= myThread then return end
            if resetAnimationPlaying then return end
            local char = lp.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end

            local elapsed = os.clock() - startTime
            if elapsed >= STEAL_DURATION then break end

            local p = math.clamp(elapsed / STEAL_DURATION, 0, 1)
            setFill(stealFill, p)

            if not blockTriggered and isWithinBlockRadius() and blockEnabled then
                blockTriggered = true
                task.spawn(doBlock)
            end

            RunService.RenderStepped:Wait()
        end

        if activeThread ~= myThread then return end
        if resetAnimationPlaying then return end

        setFill(stealFill, 1)
        for _, f in ipairs(trigger) do pcall(f) end

        setStatus("Waiting...", colors.muted)
        local waitStart = os.clock()
        while true do
            if activeThread ~= myThread then return end
            local e = os.clock() - waitStart
            if e >= WAIT_DURATION then break end
            setFill(waitFill, e / WAIT_DURATION)
            RunService.RenderStepped:Wait()
        end

        setFill(stealFill, 0)
        setFill(waitFill, 0)
        isStealing = false
        blockTriggered = false
        setStatus("Ready — move near a steal prompt.", colors.muted)
    end)
end

