-- ===== CHARACTER HOOK =====
local function resetEverything()
    activeThread = activeThread + 1
    isStealing = false
    blockTriggered = false
    setFill(stealFill, 0)
    setStatus("Ready — move near a steal prompt.", colors.muted)
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum:UnequipTools() end
end

local function hookCharacter(char)
    currentCharacterId = currentCharacterId + 1
    local myId = currentCharacterId
    resetEverything()

    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    humanoid.Died:Connect(function()
        if myId ~= currentCharacterId then return end
        resetEverything()
    end)

    humanoid.AnimationPlayed:Connect(function(track)
        if myId ~= currentCharacterId then return end
        local anim = track.Animation
        if not anim then return end
        if tostring(anim.AnimationId):find(RESET_ANIMATION_ID) then
            resetAnimationPlaying = true
            resetEverything()
            task.spawn(function()
                while true do
                    if myId ~= currentCharacterId then return end
                    if not track.IsPlaying then break end
                    task.wait()
                end
                if myId ~= currentCharacterId then return end
                resetAnimationPlaying = false
            end)
        end
    end)
end

